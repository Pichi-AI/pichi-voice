{
  "sourceLanguage": "en",
  "strings": {
    "NSAccessibilityUsageDescription": {
      "comment": "System permission purpose string. The OS identifies the app using its trusted bundle display name; keep this copy generic across brand packages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access lets the app respond to global shortcuts and type recognized text into other apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ позволяет приложению реагировать на глобальные сочетания клавиш и вводить распознанный текст в другие приложения."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "System permission purpose string. The OS identifies the app using its trusted bundle display name; keep this copy generic across brand packages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access records your voice for transcription on this Mac. Optional AI enhancement may use the provider you configure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону нужен для записи и распознавания вашей речи на этом Mac. Дополнительная обработка ИИ может использовать выбранного вами провайдера."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "comment": "System permission purpose string. The OS identifies the app using its trusted bundle display name; keep this copy generic across brand packages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio access lets you record the selected application or all system audio, according to your meeting settings. Meeting audio stays on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к системному звуку позволяет записывать выбранное приложение или звук всех приложений согласно настройкам встречи. Аудиозапись встречи остаётся на этом Mac."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "comment": "System permission purpose string. The OS identifies the app using its trusted bundle display name; keep this copy generic across brand packages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen & System Audio access lets you record the selected application or all system audio, according to your meeting settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к записи экрана и системного звука позволяет записывать выбранное приложение или звук всех приложений согласно настройкам встречи."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "comment": "System permission purpose string. The OS identifies the app using its trusted bundle display name; keep this copy generic across brand packages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission to control system events is used to manage launch at startup settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к системным событиям нужен для управления настройками автозапуска."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "System permission purpose string. The OS identifies the app using its trusted bundle display name; keep this copy generic across brand packages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition transcribes voice commands and text on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи на устройстве преобразует голосовые команды и речь в текст на этом Mac."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "System permission purpose string. Location is requested once at meeting start; reverse geocoding uses Apple services.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location once when an in-room meeting starts to save its address. Apple resolves the address from the location."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геопозиция запрашивается один раз в начале очной встречи, чтобы сохранить её адрес. Адрес определяется сервисом Apple по геопозиции."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "comment": "System permission purpose string. Location is requested once at meeting start; reverse geocoding uses Apple services.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location once when an in-room meeting starts to save its address. Apple resolves the address from the location."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геопозиция запрашивается один раз в начале очной встречи, чтобы сохранить её адрес. Адрес определяется сервисом Apple по геопозиции."
          }
        }
      }
    }
  },
  "version": "1.0"
}
