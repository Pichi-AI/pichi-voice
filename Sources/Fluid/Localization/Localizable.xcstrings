    "cloud.automatic.consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New completed protected transcripts, participant names and timing are sent to your selected account and workspace automatically. Metadata may contain personal information. Audio is not retained in this mode. Turn on Data cleanup before recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые завершённые защищённые расшифровки, имена участников и время автоматически отправляются в выбранную учётную запись и рабочее пространство. Метаданные могут содержать персональные сведения. В этом режиме аудио не сохраняется. Перед записью включите обезличивание данных."
          }
        }
      }
