        }
      }
    },
    "This removes %@ from your Mac. You’ll need to download it again to use it. Your dictation history and shortcut settings won’t change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes %@ from your Mac. You’ll need to download it again to use it. Your dictation history and shortcut settings won’t change."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель %@ будет удалена с Mac. Для использования потребуется загрузить её снова. История диктовок и сочетания клавиш сохранятся."
          }
        }
      }
    },
    "This removes its saved API key and model setup, and clears any default or prompt assignments using it. Your prompts and shortcuts are kept. You can add the provider again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes its saved API key and model setup, and clears any default or prompt assignments using it. Your prompts and shortcuts are kept. You can add the provider again later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены сохранённый API-ключ и настройки моделей, а также выбор этого провайдера по умолчанию и в промптах. Промпты и сочетания клавиш сохранятся. Позже можно снова добавить провайдера."
          }
        }
      }
    },
    "This removes saved dictation audio only. Transcript history stays intact.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved dictation audio only. Transcript history stays intact."
