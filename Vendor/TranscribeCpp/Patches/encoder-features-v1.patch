+extern "C" uint32_t transcribe_encoder_features_api_version(void) {
+    return 1;
+}
+
+extern "C" int32_t transcribe_encoder_features_supported(const transcribe_model * model) {
+    return model != nullptr && model->arch != nullptr && model->arch->encoder_features != nullptr ? 1 : 0;
+}
+
+extern "C" int32_t transcribe_clear_encoder_features(transcribe_session * session) {
+    if (session == nullptr) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    session->invalidate_encoder_features();
+    return TRANSCRIBE_OK;
+}
+
+extern "C" int32_t transcribe_get_encoder_features(const transcribe_session * session,
+                                                   uint32_t *                 frame_count,
+                                                   uint32_t *                 dimension,
+                                                   uint32_t *                 sample_rate,
+                                                   uint32_t *                 hop_samples,
+                                                   uint64_t *                 generation,
+                                                   float *                    destination,
+                                                   uint64_t                   capacity_elements) {
+    if (frame_count != nullptr) {
+        *frame_count = 0;
+    }
+    if (dimension != nullptr) {
+        *dimension = 0;
+    }
+    if (sample_rate != nullptr) {
+        *sample_rate = 0;
+    }
+    if (hop_samples != nullptr) {
+        *hop_samples = 0;
+    }
+    if (generation != nullptr) {
+        *generation = 0;
+    }
+    const auto status = api_guard_status("transcribe_get_encoder_features", [&] {
+        if (session == nullptr || frame_count == nullptr || dimension == nullptr || sample_rate == nullptr ||
+            hop_samples == nullptr || generation == nullptr || (destination == nullptr && capacity_elements != 0) ||
+            capacity_elements > 524288) {
+            return TRANSCRIBE_ERR_INVALID_ARG;
+        }
+        if (!transcribe_encoder_features_supported(session->model)) {
+            return TRANSCRIBE_ERR_NOT_IMPLEMENTED;
+        }
+        // Invoke the installed callback on the same serialized native thread.
+        auto * mutable_session = const_cast<transcribe_session *>(session);
+        if (mutable_session->poll_abort()) {
+            mutable_session->invalidate_encoder_features();
+            return TRANSCRIBE_ERR_ABORTED;
+        }
+        if (!session->encoder_features_ready || !session->has_result || session->was_aborted ||
+            session->was_truncated || session->stream_state == TRANSCRIBE_STREAM_ACTIVE) {
+            return TRANSCRIBE_ERR_INVALID_ARG;
+        }
+        const float * data   = nullptr;
+        uint32_t      frames = 0, dim = 0, rate = 0, hop = 0;
+        const auto    st = session->model->arch->encoder_features(session, &data, &frames, &dim, &rate, &hop);
+        if (st != TRANSCRIBE_OK) {
+            return st;
+        }
+        const uint64_t count = static_cast<uint64_t>(frames) * dim;
+        if (data == nullptr || frames == 0 || frames > 600 || dim == 0 || dim > 1024 || count > 524288 || rate == 0 ||
+            hop == 0 || hop > rate) {
+            return TRANSCRIBE_ERR_INPUT_TOO_LONG;
+        }
+        if (destination != nullptr && capacity_elements < count) {
+            return TRANSCRIBE_ERR_INPUT_TOO_LONG;
+        }
+        for (uint64_t i = 0; i < count; ++i) {
+            if (!std::isfinite(data[i])) {
+                return TRANSCRIBE_ERR_BACKEND;
+            }
+        }
+        if (destination != nullptr) {
+            std::memcpy(destination, data, static_cast<size_t>(count) * sizeof(float));
+        }
+        if (mutable_session->poll_abort()) {
+            mutable_session->invalidate_encoder_features();
+            return TRANSCRIBE_ERR_ABORTED;
+        }
+        *frame_count = frames;
+        *dimension   = dim;
+        *sample_rate = rate;
+        *hop_samples = hop;
+        *generation  = session->encoder_features_generation;
+        return TRANSCRIBE_OK;
+    });
+    return static_cast<int32_t>(status);
+}
