+/* Optional encoder-snapshot API v1. Resolve all four symbols when using an
+ * older binary. The caller serializes clear, run, query and copy with the
+ * same model compute lease. No pointers into native storage escape.
+ *
+ * clear is required BEFORE every run attempt: the established run API may
+ * reject malformed PCM without dereferencing even a non-NULL session. Such
+ * malformed calls therefore cannot invalidate a previously valid snapshot.
+ * Accepted attempts, batch and stream operations invalidate automatically.
+ * Only a successful single run may publish a snapshot. Cancellation prevents
+ * query/copy, including cancellation that arrives just after run returned.
+ *
+ * get: NULL destination with capacity 0 queries metadata. Otherwise capacity
+ * is measured in floats. Maximum 524288 floats (2 MiB), 600 frames and 1024
+ * dimensions. Metadata is zeroed on error. A too-small capacity returns
+ * INPUT_TOO_LONG; missing successful snapshot returns INVALID_ARG;
+ * unsupported families return NOT_IMPLEMENTED. Generation changes on clear.
+ * All operations require an actual valid session/model or NULL, not a freed
+ * pointer. No function loads weights, performs inference or writes files.
+ */
+TRANSCRIBE_API uint32_t transcribe_encoder_features_api_version(void);
+TRANSCRIBE_API int32_t  transcribe_encoder_features_supported(const struct transcribe_model * model);
+TRANSCRIBE_API int32_t  transcribe_clear_encoder_features(struct transcribe_session * session);
+TRANSCRIBE_API int32_t  transcribe_get_encoder_features(const struct transcribe_session * session,
+                                                        uint32_t *                        frame_count,
+                                                        uint32_t *                        dimension,
+                                                        uint32_t *                        sample_rate,
+                                                        uint32_t *                        hop_samples,
+                                                        uint64_t *                        generation,
+                                                        float *                           destination,
+                                                        uint64_t                          capacity_elements);
+
 #ifdef __cplusplus
 } /* extern "C" */
 #endif
