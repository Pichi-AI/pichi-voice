diff --git a/tests/encoder_features_unit.cpp b/tests/encoder_features_unit.cpp
new file mode 100644
index 0000000..d675d75
--- /dev/null
+++ b/tests/encoder_features_unit.cpp
@@ -0,0 +1,109 @@
+#include "transcribe-arch.h"
+#include "transcribe-model.h"
+#include "transcribe-session.h"
+#include "transcribe.h"
+#ifdef NDEBUG
+#    undef NDEBUG
+#endif
+#include <cassert>
+#include <cmath>
+#include <limits>
+
+namespace {
+float    values[]    = { 1, 2, 3, 4, 5, 6 };
+uint32_t frame_count = 2;
+uint32_t dimension   = 3;
+bool     cancel      = false;
+bool     fail_run    = false;
+
+bool abort_callback(void *) {
+    return cancel;
+}
+
+transcribe_status features(const transcribe_session *,
+                           const float ** data,
+                           uint32_t *     frames,
+                           uint32_t *     dim,
+                           uint32_t *     rate,
+                           uint32_t *     hop) {
+    *data   = values;
+    *frames = frame_count;
+    *dim    = dimension;
+    *rate   = 16000;
+    *hop    = 640;
+    return TRANSCRIBE_OK;
+}
+
+transcribe_status run(transcribe_session * s, const float *, int, const transcribe_run_params *) {
+    s->has_result = !fail_run;
+    return fail_run ? TRANSCRIBE_ERR_BACKEND : TRANSCRIBE_OK;
+}
+}  // namespace
+
+int main() {
+    transcribe::Arch arch{};
+    arch.name             = "synthetic-test";
+    arch.run              = run;
+    arch.encoder_features = features;
+    transcribe_model model;
+    model.arch = &arch;
+    transcribe_session session;
+    session.model   = &model;
+    uint32_t frames = 9, dim = 9, rate = 9, hop = 9;
+    uint64_t generation = 9;
+    auto     query      = [&](float * dst = nullptr, uint64_t cap = 0) {
+        return transcribe_get_encoder_features(&session, &frames, &dim, &rate, &hop, &generation, dst, cap);
+    };
+    assert(transcribe_encoder_features_api_version() == 1);
+    assert(transcribe_encoder_features_supported(&model) == 1);
+    assert(transcribe_encoder_features_supported(nullptr) == 0);
+    assert(query() == TRANSCRIBE_ERR_INVALID_ARG && frames == 0 && generation == 0);
+    float pcm = 0;
+    assert(transcribe_run(&session, &pcm, 1, nullptr) == TRANSCRIBE_OK);
+    assert(query() == TRANSCRIBE_OK && frames == 2 && dim == 3 && rate == 16000 && hop == 640);
+    const auto first_generation = generation;
+    float      destination[6]   = {};
+    assert(query(destination, 5) == TRANSCRIBE_ERR_INPUT_TOO_LONG && generation == 0);
+    assert(query(destination, 6) == TRANSCRIBE_OK && destination[5] == 6 && generation == first_generation);
+    assert(transcribe_clear_encoder_features(&session) == TRANSCRIBE_OK);
+    assert(query() == TRANSCRIBE_ERR_INVALID_ARG);
+    assert(transcribe_run(&session, &pcm, 1, nullptr) == TRANSCRIBE_OK);
+    assert(query() == TRANSCRIBE_OK && generation != first_generation);
+    transcribe_set_abort_callback(&session, abort_callback, nullptr);
+    cancel = true;
+    assert(query() == TRANSCRIBE_ERR_ABORTED && frames == 0);
+    cancel = false;
+    assert(query() == TRANSCRIBE_ERR_INVALID_ARG);
+    assert(transcribe_run(&session, &pcm, 1, nullptr) == TRANSCRIBE_OK);
+    fail_run = true;
+    assert(transcribe_run(&session, &pcm, 1, nullptr) == TRANSCRIBE_ERR_BACKEND);
+    assert(query() == TRANSCRIBE_ERR_INVALID_ARG);
+    fail_run = false;
+    assert(transcribe_run(&session, &pcm, 1, nullptr) == TRANSCRIBE_OK);
+    values[0] = std::numeric_limits<float>::infinity();
+    assert(query() == TRANSCRIBE_ERR_BACKEND && frames == 0);
+    values[0]   = 1;
+    frame_count = 601;
+    assert(query() == TRANSCRIBE_ERR_INPUT_TOO_LONG);
+    frame_count = 2;
+    dimension   = 1025;
+    assert(query() == TRANSCRIBE_ERR_INPUT_TOO_LONG);
+    dimension = 3;
+    transcribe_run_params params;
+    transcribe_run_params_init(&params);
+    params.struct_size = 0;
+    assert(transcribe_run(&session, &pcm, 1, &params) == TRANSCRIBE_ERR_BAD_STRUCT_SIZE);
+    assert(query() == TRANSCRIBE_ERR_INVALID_ARG);
+    // Existing no-dereference malformed-run contract remains intact.
+    assert(transcribe_run(reinterpret_cast<transcribe_session *>(1), nullptr, 1, nullptr) ==
+           TRANSCRIBE_ERR_INVALID_ARG);
+    assert(transcribe_run(&session, &pcm, 1, nullptr) == TRANSCRIBE_OK);
+    const float * inputs[]  = { &pcm };
+    int           lengths[] = { 1 };
+    assert(transcribe_run_batch(&session, inputs, lengths, 1, nullptr) == TRANSCRIBE_OK);
+    assert(query() == TRANSCRIBE_ERR_INVALID_ARG);
+    arch.encoder_features = nullptr;
+    assert(transcribe_encoder_features_supported(&model) == 0);
+    assert(query() == TRANSCRIBE_ERR_NOT_IMPLEMENTED);
+    return 0;
+}
