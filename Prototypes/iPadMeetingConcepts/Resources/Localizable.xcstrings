    "audio_and_text_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proposed default keeps both the transcript and recording locally for playback and reprocessing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию предлагается хранить транскрипт и запись локально для прослушивания и повторной обработки."
          }
        }
      }
    },
    "text_only_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposed strict mode: no audio files, including temporary files. Bounded memory buffers feed transcription. Audio cannot be replayed or reprocessed; recording must stop if processing cannot keep up."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
